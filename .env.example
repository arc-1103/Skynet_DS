GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Bearer token for the read-only /results API the dashboard reads over HTTP.
# Set it anywhere the webhook service is internet-reachable: unset, PR
# findings and drift results are readable by anyone. docker-compose passes
# the same value to the dashboard as SKYNET_API_TOKEN.
RESULTS_API_TOKEN=

# LLM-backed analysis pass for the specialist agents (src/agents/llm_client.py).
# Leave GROQ_API_KEY unset to run regex-only - agents fail open automatically.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
# LLM-written diagnosis explanations (prompts/explain.md). Separate opt-in:
# it sends run configs, metrics and commit SHAs to Groq. Off = template text.
MLCOP_LLM_EXPLAIN=0

# Langfuse tracing (src/core/tracing.py). Keys: Project Settings > API Keys.
# Unset = tracing silently off. Host: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), or your self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Separates test/dev traces from production ones in the Langfuse UI.
LANGFUSE_TRACING_ENVIRONMENT=development

# Diagnostic core (ML Reliability Copilot).
# fake = canned seeded regression; wandb = real runs (model_id = W&B project,
# baseline = newest finished run tagged mlcop-baseline, data version =
# config key data_version). wandb reads WANDB_API_KEY itself.
TELEMETRY_BACKEND=fake
WANDB_API_KEY=
WANDB_ENTITY=
# owner/repo the models' code lives in - code diffs between runs come from here
GITHUB_REPO=
# Deploy webhook -> model to triage, e.g. acme/fraud=fraud-clf,acme/churn=churn
MLCOP_REPO_MODELS=

# Drift + continuous monitoring (Workflows 2 and 5). Models export one gauge
# per feature: mlcop_feature_value{model="<model_id>",feature="<name>"}.
PROMETHEUS_URL=
MLCOP_DRIFT_WINDOW_SECONDS=3600
# 0 = no always-on sweep; otherwise the API server checks every N seconds
MLCOP_MONITOR_INTERVAL_SECONDS=0
# default: every model in MLCOP_REPO_MODELS
MLCOP_MONITORED_MODELS=
# repo paths of the data pipeline, e.g. pipelines/,etl/
MLCOP_PIPELINE_PATHS=
# Where diagnosis history / drift baselines live. Default is inside the image;
# docker-compose's `queue` profile points the worker at the data volume.
MLCOP_MEMORY_DB_PATH=

# Durable job queue (src/worker/celery_app.py). Unset = in-process asyncio
# queue: no Redis needed, but queued jobs die with the API process. To enable:
#   CELERY_BROKER_URL=redis://redis:6379/0   and   docker compose --profile queue up
CELERY_BROKER_URL=

# Slack incoming webhook - drift and deploy-regression verdicts are posted here.
# Unset = log only. The URL is the credential; keep it out of version control.
SLACK_WEBHOOK_URL=
