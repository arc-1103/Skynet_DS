.venv/
src/.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
data/
*.db
.env
.env.example
*.md
graphify-out/
demo-ui/
evals/
tests/
.vscode/
.impeccable/
**/node_modules/
demo/out/
demo/tests/
