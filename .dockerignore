# Keeps the build context small and out of the image - mirrors .gitignore
# plus Docker-specific exclusions. src/.venv is the big one: the dev
# virtualenv lives *inside* src/ on this machine, not at the repo root, and
# its Windows-compiled wheels have no business in a Linux image.
.git
.venv/
src/.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
data/
*.db
.env
.env.example

# Docs, planning notes, graph output, and the demo surfaces - none of this
# is needed by the core image. evals/ stays in: the image runs it. The demo
# image (demo/Dockerfile) has its own ignore file, demo/Dockerfile.dockerignore.
*.md
graphify-out/
demo/
demo-ui/
tests/
.vscode/
.impeccable/
**/node_modules/
